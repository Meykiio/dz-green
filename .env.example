# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Never exposed to the browser, never committed — the real value
# lives in your host's env config and in local .env (gitignored).
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Same project, exposed to the browser bundle. Safe: the publishable key is
# public by design and every table is behind RLS/grants.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional: server-held key for the daily-rotating device hash (abuse gate).
# Falls back to SUPABASE_PROJECT_ID when unset.
# DEVICE_HASH_KEY="generate-a-long-random-string"

# NASA FIRMS map key (server-only) for the satellite hotspot layer
# (/api/public/hotspots). Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# The route fails loud when unset. Never expose it to the browser.
FIRMS_MAP_KEY="your-32-char-map-key"

# Web Push (fire alerts): VAPID pair, generate once with
# `bunx web-push generate-vapid-keys --json`. The public key ships in the
# client bundle by design; the private key is server-only. Subject is a
# contact URI (mailto: or https:) — never localhost (Safari rejects it).
VITE_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="https://github.com/Meykiio/dz-green"
